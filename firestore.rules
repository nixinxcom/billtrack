rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileData(profileId) { return get(/databases/$(database)/documents/profiles/$(profileId)).data; }
    function isMember(profileId) { return signedIn() && request.auth.uid in profileData(profileId).memberUids; }
    function canEdit(profileId) { return isMember(profileId) && profileData(profileId).memberRoles[request.auth.uid] in ['owner', 'editor']; }

    match /profiles/{profileId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberRoles[request.auth.uid] == 'owner';
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /obligations/{obligationId} {
        allow read: if isMember(profileId);
        allow create, update, delete: if canEdit(profileId);
        match /occurrences/{occurrenceId} {
          allow read: if isMember(profileId);
          allow create, update, delete: if canEdit(profileId);
        }
      }

      match /categories/{categoryId} {
        allow read: if isMember(profileId);
        allow create, update, delete: if canEdit(profileId);
      }
    }

    match /users/{uid}/pushTokens/{tokenId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /notificationLogs/{logId} {
      allow read, write: if false;
    }
  }
}
